{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InjectAndRevertFunctionConfig",
      "Effect": "Allow",
      "Action": [
        "lambda:GetFunctionConfiguration",
        "lambda:UpdateFunctionConfiguration",
        "lambda:GetFunctionConcurrency",
        "lambda:PutFunctionConcurrency",
        "lambda:DeleteFunctionConcurrency",
        "lambda:InvokeFunction"
      ],
      "Resource": "arn:aws:lambda:*:*:function:lambda-rca-bench-*"
    },
    {
      "Sid": "InjectAndRevertRolePolicies",
      "Effect": "Allow",
      "Action": [
        "iam:GetRolePolicy",
        "iam:PutRolePolicy",
        "iam:ListRolePolicies"
      ],
      "Resource": "arn:aws:iam::*:role/lambda-rca-bench-*"
    },
    {
      "Sid": "DriftDetectionAndStackRead",
      "Effect": "Allow",
      "Action": [
        "cloudformation:DetectStackDrift",
        "cloudformation:DetectStackResourceDrift",
        "cloudformation:DescribeStackDriftDetectionStatus",
        "cloudformation:DescribeStackResourceDrifts",
        "cloudformation:DescribeStacks",
        "cloudformation:ListStackResources"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DriftDetectionReadsResources",
      "Effect": "Allow",
      "Action": [
        "lambda:GetFunction",
        "iam:GetRole",
        "iam:ListAttachedRolePolicies",
        "s3:GetBucket*",
        "s3:GetLifecycleConfiguration",
        "s3:GetEncryptionConfiguration",
        "dynamodb:DescribeTable",
        "dynamodb:DescribeContinuousBackups",
        "dynamodb:DescribeTimeToLive",
        "apigateway:GET"
      ],
      "Resource": "*"
    },
    {
      "Sid": "MetricsForBaselines",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:GetMetricData"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SeedInputs",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::lambda-rca-bench-*/*"
    }
  ]
}
